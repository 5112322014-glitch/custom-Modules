<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client action: opens the dashboard component -->
    <record id="action_basic_form_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">basic_form.dashboard</field>
    </record>

    <!-- Sub menus under the Basic Form app -->
    <menuitem id="menu_basic_form_dashboard" name="Dashboard"
              parent="menu_basic_form_root" action="action_basic_form_dashboard" sequence="1"/>
    <menuitem id="menu_basic_form_employees" name="Employees"
              parent="menu_basic_form_root" action="action_basic_form" sequence="2"/>

</odoo>
