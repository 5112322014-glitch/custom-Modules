<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. Form View: Wizard ka UI design aur rejection reason ka text field -->
        <record id="view_hr_document_request_reject_wizard_form" model="ir.ui.view">
            <field name="name">hr.document.request.reject.wizard.form</field>
            <field name="model">hr.document.request.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Rejection Reason">
                    <group>
                        <field name="reason" placeholder="Enter reason for rejection..."/>
                    </group>
                    <footer>
                        <!-- Confirm button Python ke action_confirm_reject function ko call karega -->
                        <button string="Confirm" type="object" name="action_confirm_reject" class="btn-primary"/>
                        <!-- Cancel button popup ko khud hi band kar dega -->
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- 2. Window Action: Wizard ko popup window ke tor par kholne ke liye (res_model use kiya hai) -->
        <record id="action_hr_document_request_reject_wizard" model="ir.actions.act_window">
            <field name="name">Reject Reason</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.document.request.reject.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
