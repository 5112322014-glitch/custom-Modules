<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- CHANGE: Employee rule ab base.group_user par hai (pehle hr.group_hr_user tha,
             isliye normal employee par koi rule nahi lagta tha). Domain se create_uid hata
             diya: ab jis employee ki request hai wohi dekhega, chahe HR ne banayi ho. -->
        <record id="hr_document_request_rule" model="ir.rule">
            <field name="name">HR Document Request: Employee own requests</field>
            <field name="model_id" ref="model_hr_document_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- CHANGE: HR User/Manager sab requests dekhein. Group rules OR hote hain,
             isliye HR par employee rule ka asar nahi parta. -->
        <record id="hr_document_request_manager_rule" model="ir.rule">
            <field name="name">HR Document Request: HR sees all</field>
            <field name="model_id" ref="model_hr_document_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

    </data>
</odoo>
