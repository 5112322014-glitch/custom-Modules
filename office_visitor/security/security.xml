<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_office_visitor" model="ir.module.category">
        <field name="name">Office Visitor</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_visitor_user" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="module_category_office_visitor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_visitor_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_office_visitor"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
