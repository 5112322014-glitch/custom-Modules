<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client action: opens the dashboard component -->
    <record id="action_helpdesk_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">helpdesk_basic.dashboard</field>
    </record>

    <!-- Dashboard menu, visible only to managers, shown first -->
    <menuitem id="menu_helpdesk_dashboard" name="Dashboard"
              parent="menu_helpdesk_root" action="action_helpdesk_dashboard" sequence="0"
              groups="helpdesk_basic.group_helpdesk_manager"/>

</odoo>
